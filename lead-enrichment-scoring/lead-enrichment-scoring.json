    {
      "parameters": {
        "promptType": "define",
        "text": "=Score this lead for a B2B SaaS company:\n\nCompany: {{ $('Process Leads').item.json.name }}\nCountry: {{ $('Process Leads').item.json.country }}\nEmployees: {{ $('Process Leads').item.json.employees }}\nWebsite: {{ $('Process Leads').item.json.website }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a B2B lead scoring analyst for a B2B SaaS company.\n\nScore each lead based on:\n- Company size (50-500 employees = ideal ICP)\n- International presence (multi-country = higher score)\n- Industry fit (tech, finance, healthcare = high fit)\n- Growth signals (startup, scaling, remote-first = positive)\n\nScore: 1-100\nTier: HOT (80-100), WARM (50-79), COLD (0-49)\nProvide a one-sentence rationale.\n\nRespond ONLY with structured output."
        }
      },
      "id": "agent-4",
      "name": "Score Lead",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.9,
      "position": [
        1088,
        128
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "gpt-4o-mini"
        },
        "options": {
          "temperature": 0.2
        }
      },
      "id": "oai-4",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        992,
        384
      ]
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\"score\": 85, \"tier\": \"HOT\", \"rationale\": \"Mid-size tech company in Germany with international hiring needs\"}",
        "autoFix": true
      },
      "id": "sop-4",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
