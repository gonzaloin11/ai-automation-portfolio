        384
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "l1",
              "name": "leadId",
              "value": "={{ $('Process Leads').item.json.id }}",
              "type": "number"
            },
            {
              "id": "l2",
              "name": "companyName",
              "value": "={{ $('Process Leads').item.json.name }}",
              "type": "string"
