              "name": "country",
              "value": "={{ $('Process Leads').item.json.country }}",
              "type": "string"
            },
            {
              "id": "l4",
              "name": "employees",
              "value": "={{ $('Process Leads').item.json.employees }}",
              "type": "number"
            },
            {
              "id": "l5",
              "name": "score",
              "value": "={{ $json.output?.score || 0 }}",
              "type": "number"
            },
            {
              "id": "l6",
              "name": "tier",
              "value": "={{ $json.output?.tier || 'COLD' }}",
              "type": "string"
            },
            {
              "id": "l7",
              "name": "rationale",
              "value": "={{ $json.output?.rationale || 'Scoring failed' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
