      "id": "t4-get-stock",
      "name": "Get Stock Details",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        864,
        304
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const allItems = $input.all().map(i => i.json);\n\nlet products = allItems\n  .filter(i => i.code === 200 && i.body)\n  .map(i => i.body);\n\nif (products.length === 0) {\n  return [{ json: { result: 'No se pudo obtener info de stock.' } }];\n}\n\nconst totalStock = products.reduce((sum, p) => sum + (p.available_quantity || 0), 0);\nconst sinStock = products.filter(p => (p.available_quantity || 0) === 0);\nconst bajoStock = products.filter(p => p.available_quantity > 0 && p.available_quantity <= 5);\n\nlet result = `📊 RESUMEN DE STOCK VITAGEL\\n`;\nresult += `Total productos activos: ${products.length}\\n`;\nresult += `Stock total: ${totalStock} unidades\\n`;\nresult += `Sin stock: ${sinStock.length}\\n`;\nresult += `Stock bajo (≤5): ${bajoStock.length}\\n\\n`;\n\nresult += `DETALLE:\\n`;\nproducts.forEach((p, i) => {\n  const emoji = p.available_quantity === 0 ? '🔴' : p.available_quantity <= 5 ? '🟡' : '🟢';\n  result += `${emoji} ${p.title}\\n   Stock: ${p.available_quantity} | ID: ${p.id}\\n\\n`;\n});\n\nreturn [{ json: { result } }];"
      },
      "id": "t4-format",
      "name": "Format Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1088,
        304
      ]
    },
    {
      "parameters": {
        "content": "## ML Tool - Stock Productos\n**Input**: ninguno\n**Output**: Resumen de stock de todos los productos activos con alertas\n**Llamado por**: AI Agent Lía via toolWorkflow"
      },
