        640,
        304
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "url": "=https://api.mercadolibre.com/items?ids={{ $json.results.join(',') }}&attributes=id,title,available_quantity,status",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
